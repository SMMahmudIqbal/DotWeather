<?xml version="1.0" encoding="utf-8"?>
<!-- Developed by S. M. Mahmud Iqbal -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_aqi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:contentDescription="Nothing Red Accent"
            android:src="@drawable/widget_red_dot" />

        <TextView
            android:id="@+id/widget_aqi_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="AIR // AQI"
            android:textColor="@color/nothing_white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_aqi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="GOOD"
            android:textColor="@color/nothing_white_70"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Center AQI Score & Procedural Dot Meter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_aqi_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="42"
            android:textColor="@color/nothing_white"
            android:textSize="34sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="INDEX"
            android:textColor="@color/nothing_white_40"
            android:textSize="9sp"
            android:typeface="monospace" />

        <ImageView
            android:id="@+id/widget_aqi_meter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Dot-Matrix AQI Gauge"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sensor Stats 2x2 Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PM2.5"
                    android:textColor="@color/nothing_white_40"
                    android:textSize="8sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/widget_aqi_pm25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9.2 µg"
                    android:textColor="@color/nothing_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIND"
                    android:textColor="@color/nothing_white_40"
                    android:textSize="8sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/widget_aqi_wind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 KM/H N"
                    android:textColor="@color/nothing_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HUMIDITY"
                    android:textColor="@color/nothing_white_40"
                    android:textSize="8sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/widget_aqi_humidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="65%"
                    android:textColor="@color/nothing_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UV INDEX"
                    android:textColor="@color/nothing_white_40"
                    android:textSize="8sp"
                    android:typeface="monospace" />

                <TextView
                    android:id="@+id/widget_aqi_uv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textColor="@color/nothing_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
